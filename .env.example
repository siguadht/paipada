# 火山方舟（LLM + 即梦生图共用一个 Ark API Key）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_LLM_MODEL=
ARK_IMAGE_MODEL=

# 数据库（SQLite，路径相对项目根）
# DATABASE_URL=sqlite:///./data/app.db

# JWT 会话（邀请码登录用）
JWT_SECRET=请改成一段随机字符串
JWT_EXPIRE_MINUTES=10080

# 上传与输入限制
MAX_UPLOAD_MB=10
MAX_INPUT_CHARS=200

# 超时与重试
LLM_TIMEOUT_SECONDS=30
IMAGE_TIMEOUT_SECONDS=60
MAX_REGENERATE_TIMES=3
MAX_DESIGN_EDITS=8

# 火山 TOS 对象存储（图生图照片中转）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_BUCKET=paipaida-app
